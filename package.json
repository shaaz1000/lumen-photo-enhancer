{
  "name": "lumen-photo-enhancer",
  "version": "1.1.1",
  "description": "AI photo enhancer and upscaler: Real-ESRGAN in the browser plus an optional FastAPI server",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "weights": "python3 tools/convert_weights.py",
    "bench": "node bench/build.mjs && node bench/.build/run.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vladmandic/face-api": "^1.7.15",
    "esbuild": "^0.24.2",
    "onnxruntime-node": "^1.20.1",
    "playwright-core": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "private": true
}